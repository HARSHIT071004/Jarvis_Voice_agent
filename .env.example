# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_key_here

# Real-time voice model (free-tier Live model)
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Wake phrase (must match the phrase encoded into the KWS keywords file)
WAKE_WORD=jarvis

# Wake-word detector tuning (0..1, higher = harder to trigger)
WAKE_KEYWORD_SCORE=1.5
WAKE_THRESHOLD=0.25

# Session lifecycle (seconds)
WAKE_CONFIRMATION_TIMEOUT=10
VOICE_INACTIVITY_TIMEOUT=45
VOICE_SESSION_TIMEOUT=300
RECONNECT_ATTEMPTS=2

# Audio device indices (blank = system default). Run
#   python -m app.audio.devices
# to list them.
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# Conversation Intelligence (Phase 2)
# Extraction runs in the background after each completed turn.
# Must be a TEXT-capable model: the Live voice model rejects generateContent.
INTELLIGENCE_ENABLED=true
INTELLIGENCE_MODEL=gemini-3.8-flash

# Logging
LOG_LEVEL=INFO

# Phase 5: web research
RESEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo_html   # keyless; future providers may need WEB_SEARCH_API_KEY
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT=8
REQUEST_TIMEOUT=10
MAX_PAGE_SIZE=2097152                 # bytes (2 MB)
MAX_RESEARCH_SOURCES=6
MAX_RESEARCH_OPEN=6

# Phase 6: browser / computer-use agent
BROWSER_ENABLED=true
BROWSER_HEADLESS=true                 # set false to watch the browser during dev
BROWSER_TIMEOUT=15000                # ms, navigation timeout
BROWSER_MAX_STEPS=15                 # browser actions per task before stopping
BROWSER_MAX_DOWNLOAD_SIZE=10485760   # bytes (10 MB)
BROWSER_DOWNLOAD_DIR=data/downloads
BROWSER_UPLOAD_DIR=data/uploads      # drop files here; refer to them by file_id
BROWSER_ALLOWED_SCHEMES=http,https
BROWSER_BLOCKED_DOMAINS=             # extra blocked domains (comma separated)

# Phase 7: productivity agent (Gmail + Calendar)
PRODUCTIVITY_ENABLED=true
TIMEZONE=Asia/Kolkata                  # IANA zone used for all date/time parsing
GOOGLE_CLIENT_FILE=data/google_client.json   # OAuth client JSON from Google Cloud
OAUTH_TOKEN_PATH=data/google_oauth.json      # created by scripts/google_auth.py
GMAIL_MAX_RESULTS=10                   # search results per call (bounded)
GMAIL_MAX_BODY_CHARS=8000              # email body cap handed to the model
CALENDAR_MAX_EVENTS=50
CALENDAR_MAX_RANGE_DAYS=31             # widest list/availability window


# Phase 8: security control plane (secure defaults - do not weaken)
SECURITY_ENABLED=true
APPROVAL_REQUIRED_FOR_HIGH_RISK=true   # HIGH-risk actions need a human yes
APPROVAL_TIMEOUT_SECONDS=120           # approvals expire after this long
CRITICAL_ACTION_MODE=deny              # deny | allow (keep deny)
AUDIT_ENABLED=true                     # structured audit trail (data/audit.jsonl)
AUDIT_REDACT_SENSITIVE_DATA=true       # never store credential material in audit
AUDIT_PATH=data/audit.jsonl
SECURITY_DENIED_TOOLS=                 # comma-separated tool names denied at the gate
